<%- include("layout.ejs", { pageTitle: "Sign in" }) %>
<main class="page">
    <section class="card" aria-labelledby="page-title">
        <h1 id="page-title">Sign in</h1>
        <p class="intro">Use your account details to open your private dashboard.</p>

        <% if (typeof success !== "undefined" && success) { %>
            <div class="alert success" role="status"><%= success %></div>
        <% } %>
        <% if (typeof error !== "undefined" && error) { %>
            <div class="alert error" role="alert"><%= error %></div>
        <% } %>

        <form method="post" action="/login">
            <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" maxlength="72" required>
            </div>
            <button type="submit">Sign in</button>
        </form>
        <p class="links">New here? <a href="/register">Create an account</a></p>
    </section>
</main>
</body>
</html>