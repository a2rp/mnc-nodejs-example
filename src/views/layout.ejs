<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b1525">
    <title><%= typeof pageTitle !== "undefined" ? pageTitle : "MNC Node.js MVC" %></title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172338; background: #eef3f8; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; }
        header { background: #0b1525; color: #fff; padding: 16px 24px; }
        header a { color: inherit; font-weight: 700; text-decoration: none; }
        .page { width: min(100% - 32px, 560px); margin: 48px auto; }
        .card { background: #fff; border: 1px solid #dce4ee; border-radius: 16px; padding: 28px; box-shadow: 0 12px 36px rgba(20, 42, 71, .08); }
        h1 { margin: 0 0 8px; font-size: clamp(24px, 4vw, 32px); }
        .intro { margin: 0 0 24px; color: #5a687b; line-height: 1.6; }
        .field { margin: 16px 0; }
        label { display: block; margin-bottom: 6px; font-weight: 600; }
        input { width: 100%; min-height: 44px; border: 1px solid #c8d2df; border-radius: 8px; padding: 10px 12px; font: inherit; }
        input:focus { outline: 3px solid rgba(20, 184, 166, .2); border-color: #0d9488; }
        button { width: 100%; min-height: 46px; border: 0; border-radius: 8px; padding: 12px 16px; background: #0d9488; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
        button:hover { background: #0f766e; }
        .links { margin-top: 18px; text-align: center; color: #5a687b; }
        a { color: #0f766e; }
        .alert { margin: 18px 0; border-radius: 8px; padding: 12px 14px; line-height: 1.45; }
        .alert.error { background: #fff1f0; color: #a5261a; border: 1px solid #ffd0cb; }
        .alert.success { background: #ecfdf5; color: #166534; border: 1px solid #bbf7d0; }
        .dashboard-data { margin: 24px 0; padding: 18px; border-radius: 10px; background: #f4f8fb; line-height: 1.8; }
        @media (max-width: 520px) { .page { margin: 24px auto; } .card { padding: 22px; } header { padding: 14px 18px; } }
    </style>
</head>
<body>
<header><a href="/">MNC Node.js MVC</a></header>